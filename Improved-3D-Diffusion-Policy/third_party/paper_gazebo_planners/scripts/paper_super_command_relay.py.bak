#!/usr/bin/env python3
"""SUPER-side entry point of the generic command bridge.

Kept as its own file because super.launch already refers to it. It only fixes the
default source topic; the mechanics live in paper_cmd_relay.run().

Why the sys.path insert: this node must subscribe with SUPER's own
`quadrotor_msgs` definition (md5 d008e86de36e11deb1e4033ac2c394a9), but when both
planner workspaces are on PYTHONPATH the Fast-Planner one (4712f060...) comes
first and the subscription would silently never fire (a mismatched-md5 subscriber
receives nothing and reports nothing). Prepending SUPER's dist-packages makes the
import resolve to SUPER's definition regardless of PYTHONPATH order.
"""
import sys

_SUPER_PY = '/home/cjj/AUV/program/paper_super_ws/devel/lib/python3/dist-packages'
if _SUPER_PY not in sys.path:
    sys.path.insert(0, _SUPER_PY)

from paper_cmd_relay import run

if __name__ == '__main__':
    sys.exit(run('/paper/super/pos_cmd', node_name='paper_super_command_relay'))
