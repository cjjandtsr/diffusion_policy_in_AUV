<launch>
  <!-- Paper adapter: synchronous SUPER evaluation service (kinematics arm).
       The node drives the official SUPER FSM/map/planner only from service
       requests. config_path points at the effective YAML generated by
       scripts/prepare_paper_super_sync_config.py (timer_en=false,
       ros_callback.enable=false, visualization.enable=false). -->
  <arg name="config_path" default=""/>
  <node pkg="paper_super_sync" type="paper_super_sync_node" name="paper_super_sync"
        output="screen" required="true">
    <param name="config_path" value="$(arg config_path)"/>
  </node>
</launch>
