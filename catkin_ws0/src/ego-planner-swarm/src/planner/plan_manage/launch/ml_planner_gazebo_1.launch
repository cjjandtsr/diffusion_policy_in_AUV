<launch>
    <!-- ML Planner Gazebo 启动文件 (修复版) -->
    
    <arg name="drone_id" default="0"/>
    
    <arg name="map_size_x" value="30.0"/>
    <arg name="map_size_y" value="30.0"/>
    <arg name="map_size_z" value="5.0"/>
    
    <!-- 预设航点 -->
    <arg name="waypoint_num" value="1" />
    <arg name="waypoint0_x" value="15.0" />
    <arg name="waypoint0_y" value="0.0" />
    <arg name="waypoint0_z" value="1.5" />
    <arg name="waypoint1_x" value="8.0" />
    <arg name="waypoint1_y" value="0.0" />
    <arg name="waypoint1_z" value="1.5" />

    <!-- 话题（与EGO系统一致） -->
    <arg name="odom_topic" value="/mavros/local_position/odom"/>
    <arg name="pointcloud_topic" value="/iris_D435i/realsense/depth_camera/depth/points"/>
    <arg name="cmd_topic" value="/planning/pos_cmd"/>

    <!-- ML规划器节点 -->
    <node name="drone_$(arg drone_id)_ml_planner" 
          pkg="ego_planner"
          type="ml_planner_gazebo.py"
          output="screen">
        
        <!-- ⭐ 关键：传入drone_id供Python代码构造EGO话题名 -->
        <param name="drone_id" value="$(arg drone_id)" />
        
        <param name="waypoint_num" value="$(arg waypoint_num)" />
        <param name="waypoint0_x" value="$(arg waypoint0_x)" />
        <param name="waypoint0_y" value="$(arg waypoint0_y)" />
        <param name="waypoint0_z" value="$(arg waypoint0_z)" />
        <param name="waypoint1_x" value="$(arg waypoint1_x)" />
        <param name="waypoint1_y" value="$(arg waypoint1_y)" />
        <param name="waypoint1_z" value="$(arg waypoint1_z)" />
        
        <remap from="~odom" to="$(arg odom_topic)" />
        <remap from="~pointcloud" to="$(arg pointcloud_topic)" />
        
        <!-- 规划参数 -->
        <param name="control_freq" value="50.0" />
        <param name="replan_ratio" value="0.7" />
        <param name="goal_tolerance" value="0.5" />
        <param name="default_height" value="1.5" />
        
        <!-- ⭐ 轨迹时间间隔：15步×0.1s=1.5秒轨迹 -->
        <param name="traj_dt" value="0.1" />
        
        <!-- 控制增益 -->
        <param name="pos_gain" value="[3.5, 3.5, 3.5]" />
        <param name="vel_gain" value="[3.5, 3.5, 3.5]" />
        
        <param name="flight_mode" value="0" />
        
        <!-- 扩散模型 -->
        <param name="checkpoint_path" value="$(env HOME)/AUV/Improved-3D-Diffusion-Policy-main/Improved-3D-Diffusion-Policy/data/outputs/2026.01.30/11.36.24_train_diffusion_unet_hybrid_drone_trajectory/checkpoints/latest.ckpt" />
    </node>

    <!-- odom_visualization（显示无人机模型+飞行路径，与EGO完全一致） -->
    <node pkg="odom_visualization" 
          name="drone_$(arg drone_id)_odom_visualization" 
          type="odom_visualization" 
          output="screen">
        <remap from="~odom" to="$(arg odom_topic)"/>
        <param name="color/a" value="1.0"/>    
        <param name="color/r" value="0.0"/>        
        <param name="color/g" value="0.0"/>        
        <param name="color/b" value="1.0"/>       
        <param name="covariance_scale" value="100.0"/>       
        <param name="robot_scale" value="1.0"/>
        <param name="tf45" value="false"/>
        <param name="drone_id" value="$(arg drone_id)"/>
    </node>
    
</launch>
