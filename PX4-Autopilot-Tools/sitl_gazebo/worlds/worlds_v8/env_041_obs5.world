              <ode><mu>1</mu><mu2>1</mu2></ode>
              <torsional><ode/></torsional>
            </friction>
          </surface>
        </collision>
      </link>
      <pose>3.9234 -8.8271 3.6066 0 0 1.5176</pose>
    </model>

    <model name='obs_03'>
      <static>1</static>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.6340</radius>
              <length>3.1997</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <n>Gazebo/White</n>
