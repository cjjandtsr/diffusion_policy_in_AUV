<sdf version='1.6'>
   <world name='single'>
     <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose frame=''>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <!-- 光源方向向量，表示太阳光照射的方向 (x, y, z) -->
      <direction>-0.5 0.1 -0.9</direction>
     </light>
     <!-- 地面模型 -->
     <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
	  <!-- 定义几何形状为平面，法向量(0,0,1)，尺寸100x100 -->
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
	  <!-- 设置碰撞接触属性，碰撞掩码65535（与所有物体碰撞） -->
          <surface>
            <contact>
              <collide_bitmask>65535</collide_bitmask>
              <ode/>
            </contact>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
              <torsional>
                <ode/>
              </torsional>
            </friction>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
	<!-- 定义地面视觉外观 -->
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
     </model>
     <!-- 设置磁场强度向量 -->
     <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
     <!-- 设置大气模型为绝热类型 -->
     <atmosphere type='adiabatic'/>
     <!-- 定义物理引擎，使用ODE引擎 -->
     <physics name='default_physics' default='0' type='ode'>
     <!-- 设置重力加速度为9.8 m/s²向下 -->
      <gravity>0 0 -9.8</gravity>
      <max_step_size>0.001</max_step_size>
      <!-- 实时因子为1（实时仿真） -->
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
     </physics>
     <!-- 场景设置:环境光颜色、背景颜色、阴影 -->
     <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
     </scene>
     <wind/>
     <!-- WGS84地球模型并设置经纬度 -->
     <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
     </spherical_coordinates>
     <!-- 墙体模型 -->
     <model name='single_wall'>
      <pose frame=''>0 0 0 0 0 -1.57</pose>
      <link name='wall_0'>
        <collision name='Wall_0_Collision'>
         <geometry>
	        <box>
	         <size>2 1 4</size>
	        </box>
	       </geometry>
	      <pose frame=''>0 0 1.25 0 0 0</pose>
	      <max_contacts>10</max_contacts>
	      <surface>
	       <contact>
	        <ode/>
	       </contact>
	       <bounce/>
	       <friction>
          <torsional>
           <ode/>
          </torsional>
          <ode/>
	       </friction>
        </surface>
       </collision>
       <visual name='Wall_0_Visual'>
        <pose frame=''>0 0 1.25 0 0 0</pose>
         <geometry>
          <box>
	         <size>2 1 3</size>
	        </box>
         </geometry>
        <material>
         <script>
          <uri>file://media/materials/scripts/gazebo.material</uri>
	        <name>Gazebo/Blue</name>
	       </script>
	       <ambient>1 1 1 1</ambient>
        </material>
         <meta>
          <layer>0</layer>
         </meta>
       </visual>
        <pose frame=''>0 0 0 0 0 0</pose>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
       <kinematic>0</kinematic>
      </link>
      <static>1</static>
     </model>
     
    <!-- 仿真状态设置 -->
    <state world_name='default'>
    <!-- 当前仿真时间742.581秒 -->
     <sim_time>742 581000000</sim_time>
     <real_time>744 625663760</real_time>
     <wall_time>1676453606 66709293</wall_time>
     <iterations>742581</iterations>
     <!-- 实时时间、墙钟时间和迭代次数 -->
     <!-- 墙体状态已注释屏蔽
     <model name='single_wall'>
        <pose frame=''>0.25 5.25 0 0 0 -1.57</pose>
        <scale>1 1 1</scale>
        <link name='wall_0'>
          <pose frame=''>-3 0 0 0 0 -1.57</pose>
          <velocity>0 0 0 0 -0 0</velocity>
          <acceleration>0 0 0 0 -0 0</acceleration>
          <wrench>0 0 0 0 -0 0</wrench>
        </link>
      </model>
      -->
      <model name='ground_plane'>
        <pose frame=''>0 0 0 0 -0 0</pose>
        <scale>1 1 1</scale>
        <link name='link'>
          <pose frame=''>0 0 0 0 -0 0</pose>
          <velocity>0 0 0 0 -0 0</velocity>
          <acceleration>0 0 0 0 -0 0</acceleration>
          <wrench>0 0 0 0 -0 0</wrench>
        </link>
      </model>
      <light name='sun'>
        <pose frame=''>0 0 10 0 -0 0</pose>
      </light>
    </state>
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>-11.0128 0.16923 13.9662 0 0.817796 0.152194</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
   </world>
</sdf>